<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.2</version>
    <relativePath/>
  </parent>

  <groupId>com.proyecto1</groupId>
  <artifactId>thymeleaf</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>thymeleaf</name>
  <description>Editor de procesos empresariales server-side</description>

  <properties>
    <java.version>17</java.version>
    <!-- Requerido por SonarCloud: identifica tu organización -->
    <sonar.organization>desarrollo-web-2630</sonar.organization>
    <!-- SonarQube necesita saber dónde está el reporte de cobertura -->
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <sonar.java.source>${java.version}</sonar.java.source>
    <!-- Sin esto Sonar avisa "Missing 'sonar.java.test.binaries' property" y
        pierde precision analizando tests (no encuentra los .class compilados) -->
    <sonar.java.binaries>${project.build.outputDirectory}</sonar.java.binaries>
    <sonar.java.test.binaries>${project.build.testOutputDirectory}</sonar.java.test.binaries>
    <!-- En la 1a entrega no hay Controllers: excluye ese paquete futuro del análisis
        para no arrastrar deuda técnica de código que aún no existe -->
    <sonar.exclusions>**/ThymeleafApplication.java</sonar.exclusions>
    <!-- Pruebas de carga (JMeter): se cambian con -Dcarga.usuarios=50 etc. -->
    <carga.usuarios>20</carga.usuarios>
    <carga.rampa>10</carga.rampa>
    <carga.repeticiones>5</carga.repeticiones>
    <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>
  </properties>

  <dependencies>
    <!-- JPA & Persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Se conserva: la lógica de envío de correo de verificación vive en el
        Service para esta entrega, aunque el endpoint REST se exponga en la 2a -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Validation: sigue siendo útil para @Valid dentro de los DTO de Service -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- H2 (pruebas / perfil local) -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Lombok: SIN versión explícita -> la gestiona el BOM del parent.
        Fijarla a mano en dos sitios (dependency + annotationProcessorPath)
        es el code smell clásico de "versiones duplicadas que pueden desincronizarse" -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- ModelMapper -->
    <dependency>
      <groupId>org.modelmapper</groupId>
      <artifactId>modelmapper</artifactId>
      <version>3.1.1</version>
    </dependency>

    <!-- Swagger / OpenAPI: documentacion interactiva de la API en
         http://localhost:8080/swagger-ui.html (se genera sola desde los controladores) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- JaCoCo: genera el jacoco.xml que SonarQube lee para cobertura -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- SonarQube: se invoca con `mvnw verify sonar:sonar`, no necesita
          <executions> propias porque no es parte del ciclo normal de build -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>3.11.0.3922</version>
      </plugin>
      <!-- JMeter: pruebas de carga. No forma parte del build normal; se corre a
           mano con `mvnw jmeter:jmeter jmeter:results` (descarga JMeter solo la
           primera vez). Los planes .jmx viven en src/test/jmeter y el reporte
           HTML queda en target/jmeter/reports -->
      <plugin>
        <groupId>com.lazerycode.jmeter</groupId>
        <artifactId>jmeter-maven-plugin</artifactId>
        <version>3.8.0</version>
        <configuration>
          <testFilesDirectory>${project.basedir}/src/test/jmeter</testFilesDirectory>
          <generateReports>true</generateReports>
          <!-- Carpeta nueva por corrida: JMeter se niega a escribir el reporte HTML
               en una carpeta que ya tiene contenido -->
          <reportDirectory>${project.build.directory}/jmeter/reports/${maven.build.timestamp}</reportDirectory>
          <!-- Los goals se invocan desde la linea de comandos (execution id default-cli);
               sin esto, jmeter:jmeter busca una execution llamada 'configuration' -->
          <selectedConfiguration>default-cli</selectedConfiguration>
          <ignoreResultFailures>true</ignoreResultFailures>
          <!-- Llegan al plan .jmx como propiedades de JMeter: ${__P(usuarios,20)} -->
          <propertiesUser>
            <usuarios>${carga.usuarios}</usuarios>
            <rampa>${carga.rampa}</rampa>
            <repeticiones>${carga.repeticiones}</repeticiones>
          </propertiesUser>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>