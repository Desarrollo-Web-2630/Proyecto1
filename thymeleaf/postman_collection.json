{
  "info": {
    "name": "Proyecto1 - API (Postman collection)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección con los endpoints principales del backend para pruebas en Postman. Variable `baseUrl` usada para la URL base."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Verificacion",
      "item": [
        {
          "name": "1 - Crear empresa (ejemplo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Empresa Test\",\n  \"nit\": \"123456789\",\n  \"correo\": \"empresa@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/empresas"
          }
        },
        {
          "name": "2 - Crear usuario (ejemplo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mariana Osorio\",\n  \"correo\": \"mariana-osoriov@javeriana.edu.co\",\n  \"password\": \"Password1A\",\n  \"rolAcceso\": \"EDITOR\",\n  \"empresaId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/v1/usuarios"
          }
        },
        {
          "name": "3 - Reenviar verificación (persistente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"mariana-osoriov@javeriana.edu.co\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reenviar-verificacion"
          }
        },
        {
          "name": "4 - Envío debug (genera debugToken si no existe usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"mariana-osoriov@javeriana.edu.co\",\n  \"name\": \"Mariana\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/debug/email"
          }
        },
        {
          "name": "5 - Verificar token (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/verificar-correo?token={{token}}"
          }
        },
        {
          "name": "Activar cuenta (fija la contrasena del admin inicial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/activar-cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "activar-cuenta"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"nuevaPassword\": \"ClaveSegura123\"\n}"
            },
            "description": "El token llega por correo (o al log si APP_MAIL_ENABLED=false). Pegalo en la variable de entorno {{token}}. Despues de esto, inicia sesion con ese correo y ClaveSegura123."
          }
        }
      ]
    },
    {
      "name": "Empresas",
      "item": [
        {
          "name": "Listar empresas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/empresas"
          }
        },
        {
          "name": "Obtener empresa por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/empresas/1"
          }
        },
        {
          "name": "Crear empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mi Empresa S.A.\",\n  \"nit\": \"900123456-7\",\n  \"correo\": \"contacto@miempresa.com\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/empresas"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios"
          }
        },
        {
          "name": "Obtener usuario",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios/1"
          }
        },
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"correo\": \"juan.perez@example.com\",\n  \"password\": \"DevPass123\",\n  \"rolAcceso\": \"EDITOR\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/usuarios"
          }
        },
        {
          "name": "Login (provisional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"juan.perez@example.com\",\n  \"password\": \"DevPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/usuarios/login"
          }
        }
      ]
    },
    {
      "name": "Procesos",
      "item": [
        {
          "name": "Listar procesos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/procesos"
          }
        },
        {
          "name": "Obtener proceso",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/procesos/1"
          }
        },
        {
          "name": "Crear proceso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Proceso de venta\",\n  \"descripcion\": \"Flujo de venta de producto\",\n  \"categoria\": \"Comercial\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/procesos"
          }
        },
        {
          "name": "Actualizar proceso",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Proceso actualizado\",\n  \"descripcion\": \"Descripcion nueva\",\n  \"categoria\": \"Operativo\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/procesos/1"
          }
        },
        {
          "name": "Publicar proceso",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/procesos/1/publicar"
          }
        }
      ]
    },
    {
      "name": "Actividades",
      "item": [
        {
          "name": "Listar actividades (por proceso)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/procesos/1/actividades"
          }
        },
        {
          "name": "Crear actividad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tarea 1\",\n  \"tipoActividad\": \"Manual\",\n  \"laneId\": 1,\n  \"posicionX\": 100,\n  \"posicionY\": 200\n}"
            },
            "url": "{{baseUrl}}/api/v1/procesos/1/actividades"
          }
        }
      ]
    },
    {
      "name": "Arcos",
      "item": [
        {
          "name": "Listar arcos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/procesos/1/arcos"
          }
        },
        {
          "name": "Crear arco",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arco A-B\",\n  \"condicion\": \"\",\n  \"origenId\": 10,\n  \"destinoId\": 11\n}"
            },
            "url": "{{baseUrl}}/api/v1/procesos/1/arcos"
          }
        }
      ]
    },
    {
      "name": "Gateways",
      "item": [
        {
          "name": "Listar gateways",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/procesos/1/gateways"
          }
        },
        {
          "name": "Crear gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Decision 1\",\n  \"tipo\": \"EXCLUSIVO\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/procesos/1/gateways"
          }
        }
      ]
    },
    {
      "name": "Elementos",
      "item": [
        {
          "name": "Listar elementos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/procesos/1/elementos"
          }
        },
        {
          "name": "Actualizar posicion elemento",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/procesos/1/elementos/10/posicion?x=150&y=250"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Entrega 2, sin autenticacion: la empresa se elige con este encabezado.",
          "var empresaId = pm.environment.get('empresaId') || '1';",
          "pm.request.headers.upsert({ key: 'X-Empresa-Id', value: String(empresaId) });"
        ]
      }
    }
  ]
}