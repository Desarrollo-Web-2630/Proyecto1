{
  "info": {
    "name": "Proyecto1 - API (Postman collection)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección con los endpoints principales del backend para pruebas en Postman. Variable `baseUrl` usada para la URL base. La variable `examplePassword` está vacía a propósito: complétala en tu Postman Environment local (nunca en la Collection) antes de correr las requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "examplePassword",
      "value": "",
      "type": "string",
      "description": "Definir en tu Environment local, nunca commitear un valor real aquí."
    }
  ],
  "item": [
    {
      "name": "Verificacion",
      "item": [
        {
          "name": "1 - Crear empresa (ejemplo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Empresa Test\",\n  \"nit\": \"123456789\",\n  \"correo\": \"empresa@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/empresas"
          }
        },
        {
          "name": "2 - Crear usuario (ejemplo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mariana Osorio\",\n  \"correo\": \"mariana-osoriov@javeriana.edu.co\",\n  \"password\": \"{{examplePassword}}\",\n  \"rolAcceso\": \"EDITOR\",\n  \"empresaId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/v1/usuarios"
          }
        },
        {
          "name": "3 - Reenviar verificación (persistente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"mariana-osoriov@javeriana.edu.co\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reenviar-verificacion"
          }
        },
        {
          "name": "4 - Envío debug (genera debugToken si no existe usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"mariana-osoriov@javeriana.edu.co\",\n  \"name\": \"Mariana\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/debug/email"
          }
        },
        {
          "name": "5 - Verificar token (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/verificar-correo?token={{token}}"
          }
        },
        {
          "name": "Activar cuenta (fija la contrasena del admin inicial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/activar-cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "activar-cuenta"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"nuevaPassword\": \"{{examplePassword}}\"\n}"
            },
            "description": "El token llega por correo (o al log si APP_MAIL_ENABLED=false). Pegalo en la variable de entorno {{token}}. Despues de esto, inicia sesion con ese correo y el valor que hayas puesto en {{examplePassword}}."
          }
        }
      ]
    },
