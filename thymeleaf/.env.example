# Copia este archivo a .env y rellena tus propios valores.
# NUNCA subas el .env real ni credenciales reales a git.

# === Base de datos PostgreSQL ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thymeleaf
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# === JWT / Seguridad ===
# Genera un valor propio, largo y aleatorio (32+ bytes). Nunca reutilices este ejemplo.
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MS=3600000

# === Correo (verificacion de cuentas) ===
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@example.com
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_BACKEND_BASE_URL=http://localhost:8080

# === SMTP ===
# Si usas Gmail, MAIL_PASSWORD debe ser una "contrasena de aplicacion", no tu
# contrasena normal. Nunca compartas esta cuenta ni la subas a git.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@example.com
MAIL_PASSWORD=CAMBIA_ESTA_CONTRASENA

SPRING_PROFILES_ACTIVE=postman
